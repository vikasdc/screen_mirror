    <string name="walk_get_started">ابدأ</string>

    <string name="walk_intro_title">انعكس هاتفك على أي تلفاز</string>
    <string name="walk_intro_body">أرسل شاشتك إلى تلفاز ذكي بدقة HD مذهلة. لاسلكيًا وفوريًا.</string>

    <string name="walk_brands_title">يعمل مع معظم أجهزة التلفاز الذكية</string>
    <string name="walk_brands_body">متوافق مع أبرز أجهزة التلفاز الذكية وأجهزة البث</string>

    <string name="walk_tv_setup_title">شغّله على تلفازك</string>
    <string name="walk_tv_setup_body">ابحث عن Screen Mirroring في التلفاز. وقد تجده أيضًا باسم Wireless Display أو Smart View أو Anyview Cast أو ببساطة Cast. مسارات شائعة حسب العلامة التجارية:</string>
    <string name="walk_tv_setup_chip_samsung">SAMSUNG</string>
    <string name="walk_tv_setup_path_samsung">اضغط SOURCE في الريموت → Screen Mirroring</string>
    <string name="walk_tv_setup_chip_lg">LG</string>
    <string name="walk_tv_setup_path_lg">Home → Screen Share</string>
    <string name="walk_tv_setup_chip_sony">SONY</string>
    <string name="walk_tv_setup_path_sony">الإعدادات → الشبكة → Chromecast المدمج</string>
    <string name="walk_tv_setup_chip_roku">ROKU</string>
    <string name="walk_tv_setup_path_roku">الإعدادات → النظام → Screen Mirroring → اسمح</string>
    <string name="walk_tv_setup_chip_firetv">FIRE TV</string>
    <string name="walk_tv_setup_path_firetv">اضغط مطولًا على HOME → Mirroring</string>
    <string name="walk_tv_setup_chip_hisense">HISENSE</string>
    <string name="walk_tv_setup_path_hisense">Apps → Anyview Cast</string>
    <string name="walk_tv_setup_chip_tcl">TCL</string>
    <string name="walk_tv_setup_path_tcl">Apps → Wireless Display</string>
    <string name="walk_tv_setup_chip_mitv">MI TV</string>
    <string name="walk_tv_setup_path_mitv">الإعدادات → الاتصال → Wireless Display</string>
    <string name="walk_tv_setup_chip_vizio">VIZIO</string>
    <string name="walk_tv_setup_path_vizio">اضغط V في الريموت → Cast (Chromecast Built-in)</string>
    <string name="walk_tv_setup_chip_panasonic">PANASONIC</string>
    <string name="walk_tv_setup_path_panasonic">Apps → Mirroring</string>

    <string name="walk_wifi_title">نفس شبكة Wi-Fi</string>
    <string name="walk_wifi_body">اربط الهاتف والتلفاز بنفس شبكة Wi-Fi حتى يتعرّفا على بعضهما.</string>
    <string name="walk_wifi_hotspot_heading">لا تتوفر Wi-Fi؟ استخدم نقطة اتصال الهاتف</string>
    <string name="walk_wifi_hotspot_step1">فعّل نقطة اتصال هاتفك من الإعدادات.</string>
    <string name="walk_wifi_hotspot_step2">في التلفاز افتح إعدادات Wi-Fi واتصل بنقطة اتصال هاتفك كأي شبكة عادية.</string>
    <string name="walk_wifi_hotspot_step3">أصبح الجهازان على نفس الشبكة. الانعكاس يعمل دون إنترنت المنزل.</string>

    <string name="walk_cast_title">ابدأ الانعكاس</string>
    <string name="walk_cast_body">جاهز. ثلاث نقرات وأنت على الشاشة الكبيرة.</string>
    <string name="walk_cast_step1">افتح Aircast على هاتفك</string>
    <string name="walk_cast_step2">انقر على %1$s</string>
    <string name="walk_cast_step3">اختر تلفازك وأكّد على شاشة التلفاز</string>

