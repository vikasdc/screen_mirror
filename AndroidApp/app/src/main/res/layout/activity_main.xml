<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_bg"
    tools:context=".MainActivity">

    <!-- Top Space for Future Google Ads (60dp) -->
    <FrameLayout
        android:id="@+id/adSlotTop"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@+id/adSlotTop"
        app:layout_constraintBottom_toTopOf="@+id/adSlotBottom">

        <!-- Logo restored to full visibility -->
        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_aircast_logo" />

        <!-- High-contrast Large Text with minimal margins -->
        <TextView
            android:id="@+id/tvAircast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aircast"
            android:textColor="@color/white_text"
            android:textSize="42sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.03"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wireless Mirroring"
            android:textColor="@color/dim_text"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:alpha="0.8"
            android:layout_marginTop="0dp" />

        <!-- Core Button Module - Large UI, tight margins -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/slate_card_border"
            android:backgroundTint="@color/slate_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="20dp"
                android:paddingHorizontal="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect to TV"
                    android:textColor="@color/white_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSearchTVs"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp"
                    android:text="Search for TVs"
                    android:backgroundTint="@color/emerald_accent"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textSize="20sp"
                    android:elevation="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan and connect to displays nearby"
                    android:textColor="@color/dim_text"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ensure your TV and mobile device are connected\nto the same Wi-Fi network."
            android:textColor="@color/dim_text"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:alpha="0.7" />

    </LinearLayout>

    <!-- Bottom Space for Future Google Ads (90dp) -->
    <FrameLayout
        android:id="@+id/adSlotBottom"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
