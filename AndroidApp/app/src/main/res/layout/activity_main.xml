<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_bg"
    tools:context=".MainActivity">

    <!-- Top Space for Future Google Ads (90dp) -->
    <FrameLayout
        android:id="@+id/adSlotTop"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Language picker chip on the top-left, mirroring the theme switch
         on the right. Tapping opens a dialog with the 15 supported locales
         (see LanguagePicker.java). -->
    <LinearLayout
        android:id="@+id/languageRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/cd_language"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/adSlotTop">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_language"
            app:tint="@color/dim_text" />

        <TextView
            android:id="@+id/languageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/dim_text"
            android:textSize="13sp"
            tools:text="English" />
    </LinearLayout>

    <!-- Theme switch row: [label] [Switch] -->
    <LinearLayout
        android:id="@+id/themeSwitchRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/adSlotTop">

        <TextView
            android:id="@+id/themeSwitchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/theme_switch_to_light"
            android:textColor="@color/dim_text"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/themeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbIcon="@drawable/switch_thumb_icon"
            app:thumbIconTint="@color/switch_thumb_icon_tint"
            app:thumbTint="@color/switch_thumb_tint"
            app:trackDecorationTint="@android:color/transparent"
            app:trackTint="@color/switch_track_tint" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@+id/themeSwitchRow"
        app:layout_constraintBottom_toTopOf="@+id/adSlotBottom">

        <!-- Animated phone-TV-cast hero. Replaces the previous logo and Aircast
             wordmark. Concentric Wi-Fi rings ripple outward from a central hub,
             and equalizer bars on the phone and TV screens pulse in sync to
             show the same content playing on both. MainActivity.onResume kicks
             off the animation. -->
        <ImageView
            android:id="@+id/imgHeroCast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxWidth="360dp"
            android:maxHeight="210dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/cd_phone_tv_cast"
            android:src="@drawable/avd_phone_tv_cast" />

        <!-- Subtitle under the hero. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="@string/home_subtitle"
            android:textColor="@color/dim_text"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/slate_card_border"
            android:backgroundTint="@color/slate_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="20dp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_connect_to_tv"
                    android:textColor="@color/white_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSearchTVs"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_search_for_tvs"
                    android:backgroundTint="@color/emerald_accent"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textSize="20sp"
                    android:elevation="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_search_subtitle"
                    android:textColor="@color/dim_text"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_wifi_hint"
            android:textColor="@color/dim_text"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:alpha="0.7" />

        <!-- Rate this app: opens the Play Store listing. -->
        <LinearLayout
            android:id="@+id/rateRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/cd_rate_app"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rate_star" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/rate_us"
                android:textColor="@color/dim_text"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- How to use: replays the onboarding walkthrough as a help guide.
             Tonal style — soft emerald fill, emerald text + icon. Visibly a
             button, but doesn't compete with the primary "Search for TVs" CTA. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/howToUseRow"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/emerald_tonal_bg"
            android:contentDescription="@string/cd_help"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:text="@string/how_to_use"
            android:textAllCaps="false"
            android:textColor="@color/emerald_accent"
            android:textSize="14sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_help_circle"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@color/emerald_accent"
            app:rippleColor="@color/emerald_ripple"
            app:strokeWidth="0dp" />

    </LinearLayout>

    <!-- Bottom Space for Future Google Ads (90dp) -->
    <FrameLayout
        android:id="@+id/adSlotBottom"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
