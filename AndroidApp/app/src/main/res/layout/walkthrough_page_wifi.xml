<?xml version="1.0" encoding="utf-8"?>
<!--
    Walkthrough page 4: same Wi-Fi network, with the phone-hotspot fallback for
    users without home Wi-Fi. Most modern TVs accept a phone hotspot like any
    other Wi-Fi network — once both devices share that network, mirroring works
    even with no home internet.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/walkAnimatedIcon"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="@null"
            android:src="@drawable/avd_walk_wifi" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/walk_wifi_title"
            android:textColor="@color/walkthrough_text_primary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/walk_wifi_body"
            android:textColor="@color/walkthrough_text_secondary"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp" />

        <!-- Hotspot fallback section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="4dp"
            android:text="@string/walk_wifi_hotspot_heading"
            android:textColor="@color/emerald_accent"
            android:textSize="16sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.01" />

        <LinearLayout style="@style/WalkStepRow">
            <TextView style="@style/WalkStepNumber" android:text="1" />
            <TextView style="@style/WalkStepText"
                android:text="@string/walk_wifi_hotspot_step1" />
        </LinearLayout>

        <LinearLayout style="@style/WalkStepRow">
            <TextView style="@style/WalkStepNumber" android:text="2" />
            <TextView style="@style/WalkStepText"
                android:text="@string/walk_wifi_hotspot_step2" />
        </LinearLayout>

        <LinearLayout style="@style/WalkStepRow">
            <TextView style="@style/WalkStepNumber" android:text="3" />
            <TextView style="@style/WalkStepText"
                android:text="@string/walk_wifi_hotspot_step3" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
