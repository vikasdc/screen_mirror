    <string name="walk_intro_title">Spiegele dein Handy auf jeden TV</string>
    <string name="walk_intro_body">Übertrage deinen Bildschirm in scharfem HD auf einen Smart TV. Drahtlos und sofort.</string>

    <string name="walk_brands_title">Funktioniert mit fast jedem Smart TV</string>
    <string name="walk_brands_body">Kompatibel mit gängigen Smart TVs und Streaming-Geräten</string>

    <string name="walk_tv_setup_title">Auf deinem TV aktivieren</string>
    <string name="walk_tv_setup_body">Suche Screen Mirroring auf deinem TV. Es kann auch Wireless Display, Smart View, Anyview Cast oder einfach Cast heißen. Übliche Pfade je Marke:</string>
    <string name="walk_tv_setup_chip_samsung">SAMSUNG</string>
    <string name="walk_tv_setup_path_samsung">SOURCE auf der Fernbedienung → Screen Mirroring</string>
    <string name="walk_tv_setup_chip_lg">LG</string>
    <string name="walk_tv_setup_path_lg">Home → Screen Share</string>
    <string name="walk_tv_setup_chip_sony">SONY</string>
    <string name="walk_tv_setup_path_sony">Einstellungen → Netzwerk → Integrierter Chromecast</string>
    <string name="walk_tv_setup_chip_roku">ROKU</string>
    <string name="walk_tv_setup_path_roku">Einstellungen → System → Screen Mirroring → Zulassen</string>
    <string name="walk_tv_setup_chip_firetv">FIRE TV</string>
    <string name="walk_tv_setup_path_firetv">HOME gedrückt halten → Mirroring</string>
    <string name="walk_tv_setup_chip_hisense">HISENSE</string>
    <string name="walk_tv_setup_path_hisense">Apps → Anyview Cast</string>
    <string name="walk_tv_setup_chip_tcl">TCL</string>
    <string name="walk_tv_setup_path_tcl">Apps → Wireless Display</string>
    <string name="walk_tv_setup_chip_mitv">MI TV</string>
    <string name="walk_tv_setup_path_mitv">Einstellungen → Verbindung → Wireless Display</string>
    <string name="walk_tv_setup_chip_vizio">VIZIO</string>
    <string name="walk_tv_setup_path_vizio">V auf der Fernbedienung → Cast (Chromecast Built-in)</string>
    <string name="walk_tv_setup_chip_panasonic">PANASONIC</string>
    <string name="walk_tv_setup_path_panasonic">Apps → Mirroring</string>

    <string name="walk_wifi_title">Selbes WLAN</string>
    <string name="walk_wifi_body">Verbinde Handy und TV mit demselben WLAN, damit sie sich finden.</string>
    <string name="walk_wifi_hotspot_heading">Kein WLAN? Nutze den Hotspot deines Handys</string>
    <string name="walk_wifi_hotspot_step1">Aktiviere den Hotspot deines Handys in den Einstellungen.</string>
    <string name="walk_wifi_hotspot_step2">Öffne am TV die WLAN-Einstellungen und verbinde dich mit deinem Hotspot wie mit einem normalen Netz.</string>
    <string name="walk_wifi_hotspot_step3">Beide Geräte sind im selben Netz. Spiegeln funktioniert ohne Heim-Internet.</string>

    <string name="walk_cast_title">Spiegelung starten</string>
    <string name="walk_cast_body">Du bist startklar. Drei Tipps und du bist auf dem großen Bildschirm.</string>
    <string name="walk_cast_step1">Öffne Aircast auf deinem Handy</string>
    <string name="walk_cast_step2">Tippe auf %1$s</string>
    <string name="walk_cast_step3">Wähle deinen TV und bestätige am TV-Bildschirm</string>

