# Aircast release-signing config template.
#
# Copy this file to app/keystore.properties (same folder), fill in the four
# values below, and run `./gradlew bundleRelease` from AndroidApp/.
# The real keystore.properties is gitignored. Do not commit it.
#
# Use forward slashes in storeFile, even on Windows. Java's File API handles
# them fine and you avoid the backslash-escaping mess.

storeFile=I:/Other computers/My Mac/Documents/aircast-release-key.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=aircast-key
keyPassword=YOUR_KEY_PASSWORD
