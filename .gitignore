# --------------------------------------------------------------------------
# Aircast Absolute Cleanup: Nuking the 10k untracked files
# --------------------------------------------------------------------------

# 1. Ignore EVERYTHING at ANY depth
**

# 2. Allow only these folders and files
!/.gitignore
!/README.md
!/CLAUDE.md
!/privacy_policy.html
!/play_store_assets/
!/play_store_assets/*.png
!/play_store_assets_v2/
!/play_store_assets_v2/**
!/AndroidApp/
!/AndroidApp/**
# Multi-machine workflow files. SESSION_HANDOFF.md and routine-locks.json
# MUST sync via git. .claude/worktrees/ is re-ignored below.
!/.claude/
!/.claude/**

# 3. CRITICAL: Re-ignore the specific junk folders INSIDE AndroidApp
# These are the ones creating the 10,000+ files
**build/
**/.gradle/
**/.idea/
**/.vscode/
**/android_sdk/
**/node_modules/
**/jdk-*/
**/gradle/
**/gradle*
**/gradlew*
**/*.bin
**/*.lock
**/*.zip
**/*.log
**/*.txt
**/*.class
**/.DS_Store
**/android_prefs/
**/tmp/
**/build.log
**/build_output*
**/emulator_screenshot.png

# Release signing creds. Template lives at app/keystore.properties.example.
**/keystore.properties

# Release signing keystore. Never commit. Stored outside the repo.
**/*.jks
**/*.keystore

# Machine-specific Android SDK path.
**/local.properties

# Playwright video raw output (we keep only the final webm/mp4 in out/).
**/video_raw/
**/node_modules/

# Subagent worktrees: temporary git worktrees the assistant spins up. Never sync.
.claude/worktrees/
